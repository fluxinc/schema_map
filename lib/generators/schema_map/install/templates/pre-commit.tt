#!/bin/sh
# Installed by schema_map. Blocks a commit while the data-model map in <%= options[:file] %> is stale.
# The comparison runs in the test environment, loaded from db/schema.rb, so it checks the block against
# the schema this commit ships — not against the developer database's migration state.
# This hook never rewrites files. When it fails: run `bin/rails agents:data_model`, review, re-stage, commit.
# Enable per clone with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
RAILS_ENV=test bin/rails db:test:prepare >/dev/null
exec env RAILS_ENV=test bin/rails agents:data_model:check
